# Copiar este archivo a .env (en la raiz del repo) y completar con valores reales.
# .env esta en .gitignore: nunca se commitea. docker-compose.yml lo lee automaticamente.

# Password del usuario root de MySQL (uso administrativo, la app NO lo usa).
MYSQL_ROOT_PASSWORD=cambia_esto_por_algo_fuerte

# Password del usuario de aplicacion (privilegios solo sobre la base "plataforma").
# El backend se conecta con este usuario, no con root. Ver backend/src/main/resources/
# application-local.properties.example.
MYSQL_APP_PASSWORD=cambia_esto_tambien
